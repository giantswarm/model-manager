{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "additionalProperties": false,
    "properties": {
        "affinity": {
            "type": "object",
            "description": "Affinity.",
            "additionalProperties": true
        },
        "backend": {
            "type": "string",
            "description": "Serving backend driver: `ollama` (host Ollama — laptop/agentlab dev loop) or `kserve` (KServe/vLLM on GPU installs: InferenceServices from serving presets, per-node Hugging Face cache, pre-warm download Jobs, fit checks). The API reports the backend and its capability flags at /api/v1/backend."
        },
        "baseDomain": {
            "type": "string"
        },
        "bootstrapMode": {
            "type": "object",
            "additionalProperties": true
        },
        "chartOperator": {
            "type": "object",
            "additionalProperties": true
        },
        "ciliumNetworkPolicy": {
            "type": "object",
            "additionalProperties": true
        },
        "cluster": {
            "type": "object",
            "additionalProperties": true
        },
        "clusterCA": {
            "type": "string"
        },
        "clusterCIDR": {
            "type": "string"
        },
        "clusterDNSIP": {
            "type": "string"
        },
        "clusterID": {
            "type": "string"
        },
        "extraArgs": {
            "type": "array",
            "description": "Extra container arguments."
        },
        "extraEnv": {
            "type": "array",
            "description": "Extra environment variables.",
            "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                    "name": {
                        "type": "string"
                    },
                    "value": {
                        "type": "string"
                    },
                    "valueFrom": {
                        "type": "object",
                        "additionalProperties": true
                    }
                }
            }
        },
        "fullnameOverride": {
            "type": "string",
            "description": "Override the fully qualified release name (the umbrella chart pins the Service name through this)."
        },
        "gcpProject": {
            "type": "string"
        },
        "global": {
            "type": [
                "object",
                "null"
            ],
            "description": "Global values shared between all subcharts",
            "$comment": "Added automatically by 'helm schema' to allow this chart to be used as a Helm dependency, as this schema would otherwise not allow Helm's special 'global' values key."
        },
        "httpRoute": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "annotations": {
                    "type": "object",
                    "description": "Annotations on the HTTPRoute.",
                    "additionalProperties": true
                },
                "enabled": {
                    "type": "boolean",
                    "description": "Expose the service through a Gateway API HTTPRoute."
                },
                "hostnames": {
                    "type": "array",
                    "description": "Hostnames matched by the route."
                },
                "labels": {
                    "type": "object",
                    "description": "Labels on the HTTPRoute.",
                    "additionalProperties": true
                },
                "parentRefs": {
                    "type": "array",
                    "description": "parentRefs of the HTTPRoute (required when enabled).",
                    "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "properties": {
                            "group": {
                                "type": "string"
                            },
                            "kind": {
                                "type": "string"
                            },
                            "name": {
                                "type": "string"
                            },
                            "namespace": {
                                "type": "string"
                            },
                            "port": {
                                "type": "integer"
                            },
                            "sectionName": {
                                "type": "string"
                            }
                        }
                    }
                }
            }
        },
        "image": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "pullPolicy": {
                    "type": "string",
                    "description": "Image pull policy."
                },
                "registry": {
                    "type": "string",
                    "description": "Image registry."
                },
                "repository": {
                    "type": "string",
                    "description": "Image repository."
                },
                "tag": {
                    "type": "string",
                    "description": "Image tag. Defaults to the chart appVersion."
                }
            }
        },
        "imagePullSecrets": {
            "type": "array",
            "description": "Image pull secrets."
        },
        "kagent": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "apiVersion": {
                    "type": "string",
                    "description": "kagent.dev API version for ModelConfigs; `auto` discovers the server's preferred version."
                },
                "autoWire": {
                    "type": "boolean",
                    "description": "Create a ModelConfig automatically when a pull completes or a model is loaded."
                },
                "disableWiring": {
                    "type": "boolean",
                    "description": "Disable all ModelConfig management; the `wire` capability reports false."
                },
                "modelConfigPrefix": {
                    "type": "string",
                    "description": "Prefix for generated ModelConfig names (empty: the sanitized model name, e.g. smollm2:135m -> smollm2-135m)."
                },
                "namespace": {
                    "type": "string",
                    "description": "Namespace where kagent ModelConfigs are created (RBAC is scoped here)."
                }
            }
        },
        "kserve": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "budget": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "defaultOverheadGiB": {
                            "type": "integer",
                            "description": "Serving overhead (KV cache, activations, runtime) added to the weights when the preset has no `requirements.overheadGiB`."
                        },
                        "source": {
                            "type": "string",
                            "description": "Node memory budget for fit checks: `auto` (GPU memory from the nvidia.com/gpu.memory x gpu.count labels when present, else allocatable memory — unified-memory nodes), `gpu-labels`, `allocatable`."
                        }
                    }
                },
                "cache": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "claimName": {
                            "type": "string",
                            "description": "PersistentVolumeClaim of the Hugging Face cache in the serving namespace; empty takes the discovery value (default `hf-cache`)."
                        },
                        "mountPath": {
                            "type": "string",
                            "description": "Where predictors mount the cache; empty takes the discovery value (default `/mnt/models`)."
                        },
                        "nodes": {
                            "type": "array",
                            "description": "Nodes that hold the cache. Empty derives them from the node affinity of the PersistentVolume bound to the claim (a static local PV pins the cache to its node)."
                        }
                    }
                },
                "discovery": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "configMap": {
                            "type": "string",
                            "description": "Name of the platform's model-serving discovery ConfigMap (kind `ModelServingConfig`, key `config.yaml`) that carries the runtime, GPU resource name, cache claim and preset selector. Empty `kserve.*` overrides below take their value from it."
                        },
                        "namespace": {
                            "type": "string",
                            "description": "Namespace of the discovery ConfigMap and, by default, of the preset ConfigMaps. Empty means the release namespace."
                        }
                    }
                },
                "download": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "ignorePatterns": {
                            "type": "array",
                            "description": "File patterns downloads skip (fnmatch, passed as STORAGE_IGNORE_PATTERNS). Empty downloads the whole repository like an InferenceService does."
                        },
                        "image": {
                            "type": "object",
                            "description": "Image of the pre-warm download Job. The KServe storage-initializer downloads exactly what an InferenceService would, so a later start finds the files and skips the download.",
                            "additionalProperties": false,
                            "properties": {
                                "name": {
                                    "type": "string"
                                },
                                "registry": {
                                    "type": "string"
                                },
                                "tag": {
                                    "type": "string"
                                }
                            }
                        },
                        "jobTTL": {
                            "type": "string",
                            "description": "ttlSecondsAfterFinished of download Jobs."
                        }
                    }
                },
                "gpuResourceName": {
                    "type": "string",
                    "description": "Accelerator resource name; empty takes the discovery value (default `nvidia.com/gpu`)."
                },
                "hf": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "endpoint": {
                            "type": "string",
                            "description": "Hugging Face Hub base URL (search, repository metadata, sizes)."
                        },
                        "token": {
                            "type": "string",
                            "description": "Render the token Secret (`kserve.hf.tokenSecret.name`, in the serving namespace) from this value. Prefer a pre-created Secret; this is for installs whose values are already secret-managed."
                        },
                        "tokenSecret": {
                            "type": "object",
                            "additionalProperties": false,
                            "properties": {
                                "key": {
                                    "type": "string",
                                    "description": "Key of the token in that Secret."
                                },
                                "name": {
                                    "type": "string",
                                    "description": "Secret in the serving namespace holding a Hugging Face token for gated repositories (read by model-manager, mounted into download Jobs). Empty: anonymous hub access, gated models refused."
                                }
                            }
                        }
                    }
                },
                "inventory": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "image": {
                            "type": "object",
                            "description": "Image that creates cache directories (download Job init container) and scans / cleans the cache (short-lived pods); needs sh, find, stat, awk (busybox).",
                            "additionalProperties": false,
                            "properties": {
                                "name": {
                                    "type": "string"
                                },
                                "registry": {
                                    "type": "string"
                                },
                                "tag": {
                                    "type": "string"
                                }
                            }
                        },
                        "timeout": {
                            "type": "string",
                            "description": "Time budget of one scan pod."
                        },
                        "ttl": {
                            "type": "string",
                            "description": "How long one cache scan is reused before a node is scanned again."
                        }
                    }
                },
                "namespace": {
                    "type": "string",
                    "description": "Serving namespace: InferenceServices, download Jobs, cache-tool pods and the cache claim live here and the kserve RBAC Role is created here. Must match the platform's `components.modelServing.namespace.name`."
                },
                "presets": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "labelSelector": {
                            "type": "string",
                            "description": "Label selector of the serving-preset ConfigMaps; empty takes the discovery value (default `agent-platform.giantswarm.io/serving-preset=true`)."
                        },
                        "namespace": {
                            "type": "string",
                            "description": "Namespace of the serving-preset ConfigMaps; empty takes the discovery value, else `kserve.discovery.namespace`."
                        }
                    }
                },
                "readyTimeout": {
                    "type": "string",
                    "description": "How long a load job waits for an InferenceService to become ready before it gives up on wiring."
                },
                "runtime": {
                    "type": "string",
                    "description": "ClusterServingRuntime for presets that name none; empty takes the discovery value (default `kserve-vllm`)."
                }
            }
        },
        "logging": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "verbose": {
                    "type": "boolean",
                    "description": "Enable debug logging."
                }
            }
        },
        "mcp": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "enabled": {
                    "type": "boolean",
                    "description": "Serve the MCP streamable-HTTP endpoint alongside the REST API."
                },
                "path": {
                    "type": "string",
                    "description": "MCP endpoint path."
                }
            }
        },
        "muster": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "mcpServer": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "description": {
                            "type": "string",
                            "description": "Human-readable description shown by muster."
                        },
                        "autoStart": {
                            "type": "boolean",
                            "description": "Start the server connection when muster initializes."
                        },
                        "enabled": {
                            "type": "boolean",
                            "description": "Register this server with muster by rendering an `mcpservers.muster.giantswarm.io` CR in the release namespace. Tools then appear as `x_<name>_<tool>`."
                        },
                        "labels": {
                            "type": "object",
                            "description": "Extra labels on the MCPServer CR.",
                            "additionalProperties": true
                        },
                        "name": {
                            "type": "string",
                            "description": "MCPServer CR name (drives the tool prefix)."
                        }
                    }
                }
            }
        },
        "nameOverride": {
            "type": "string",
            "description": "Override the chart name."
        },
        "networkPolicy": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "allowKubeAPI": {
                    "type": "boolean",
                    "description": "Allow egress to the Kubernetes API server (needed for wiring)."
                },
                "egressCIDRs": {
                    "type": "array",
                    "description": "Extra egress CIDRs (the host Ollama endpoint, e.g. 172.21.0.1/32)."
                },
                "enabled": {
                    "type": "boolean",
                    "description": "Create a Kubernetes NetworkPolicy for the pod."
                },
                "ingressNamespaces": {
                    "type": "array",
                    "description": "Namespaces allowed to reach the API (label kubernetes.io/metadata.name). Empty allows ingress from the release namespace only."
                }
            }
        },
        "nodeSelector": {
            "type": "object",
            "description": "Node selector.",
            "additionalProperties": true
        },
        "oauth": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "baseURL": {
                    "type": "string",
                    "description": "Public base URL of this server (https, or http on loopback only)."
                },
                "dex": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "clientID": {
                            "type": "string",
                            "description": "Dex OAuth client ID."
                        },
                        "clientSecret": {
                            "type": "string",
                            "description": "Dex OAuth client secret (prefer `oauth.existingSecret`)."
                        },
                        "issuerURL": {
                            "type": "string",
                            "description": "Dex issuer URL."
                        }
                    }
                },
                "enabled": {
                    "type": "boolean",
                    "description": "Protect the MCP endpoint with an embedded OAuth 2.1 server (Dex upstream). Off by default: on the platform, muster is the auth enforcement point in front of MCP servers."
                },
                "existingSecret": {
                    "type": "string",
                    "description": "Existing Secret with key `dex-client-secret`."
                }
            }
        },
        "ollama": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "agentHost": {
                    "type": "string",
                    "description": "Ollama host written into kagent ModelConfigs, as reached by agent pods; reported as `agentEndpoint` by `GET /api/v1/backend`. Empty means the same as `ollama.endpoint`."
                },
                "endpoint": {
                    "type": "string",
                    "description": "Ollama API base URL as reached from pods. On kind this is the docker network gateway (for example http://172.21.0.1:11434 — agentlab sets it); Docker Desktop resolves host.docker.internal."
                }
            }
        },
        "podAnnotations": {
            "type": "object",
            "description": "Annotations on the pod.",
            "additionalProperties": true
        },
        "podLabels": {
            "type": "object",
            "description": "Labels on the pod.",
            "additionalProperties": true
        },
        "podSecurityContext": {
            "type": "object",
            "description": "Pod security context.",
            "additionalProperties": false,
            "properties": {
                "fsGroup": {
                    "type": "integer"
                },
                "runAsGroup": {
                    "type": "integer"
                },
                "runAsNonRoot": {
                    "type": "boolean"
                },
                "runAsUser": {
                    "type": "integer"
                },
                "seccompProfile": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "type": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "provider": {
            "type": "string"
        },
        "rbac": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "create": {
                    "type": "boolean",
                    "description": "Create the Role/RoleBinding for ModelConfigs and Secrets in `kagent.namespace` (and, when `backend` is kserve, the Role in the serving namespace, the Role for the discovery/preset ConfigMaps and the ClusterRole for nodes and PersistentVolumes)."
                }
            }
        },
        "replicaCount": {
            "type": "integer",
            "description": "Number of replicas. Jobs are tracked in memory, so keep this at 1 unless clients pin to one pod."
        },
        "resources": {
            "type": "object",
            "description": "Container resources.",
            "additionalProperties": false,
            "properties": {
                "limits": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "cpu": {
                            "type": "string"
                        },
                        "memory": {
                            "type": "string"
                        }
                    }
                },
                "requests": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "cpu": {
                            "type": "string"
                        },
                        "memory": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "securityContext": {
            "type": "object",
            "description": "Container security context.",
            "additionalProperties": false,
            "properties": {
                "allowPrivilegeEscalation": {
                    "type": "boolean"
                },
                "capabilities": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "drop": {
                            "type": "array",
                            "items": {
                                "type": "string"
                            }
                        }
                    }
                },
                "readOnlyRootFilesystem": {
                    "type": "boolean"
                },
                "runAsGroup": {
                    "type": "integer"
                },
                "runAsNonRoot": {
                    "type": "boolean"
                },
                "runAsUser": {
                    "type": "integer"
                },
                "seccompProfile": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "type": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "service": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "type": {
                    "type": "string",
                    "description": "Service type."
                },
                "port": {
                    "type": "integer",
                    "description": "Service port (container listens on 8080)."
                }
            }
        },
        "serviceAccount": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "annotations": {
                    "type": "object",
                    "description": "Annotations on the ServiceAccount.",
                    "additionalProperties": true
                },
                "create": {
                    "type": "boolean",
                    "description": "Create a ServiceAccount."
                },
                "name": {
                    "type": "string",
                    "description": "ServiceAccount name (generated when empty)."
                }
            }
        },
        "subscriptionID": {
            "type": "string"
        },
        "tolerations": {
            "type": "array",
            "description": "Tolerations.",
            "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                    "effect": {
                        "type": "string"
                    },
                    "key": {
                        "type": "string"
                    },
                    "operator": {
                        "type": "string"
                    },
                    "tolerationSeconds": {
                        "type": "integer"
                    },
                    "value": {
                        "type": "string"
                    }
                }
            }
        }
    }
}
